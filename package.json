    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
